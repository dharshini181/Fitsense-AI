## FitSense AI 2.0 — Environment Variables
# Copy this file to .env and fill in your real values


# Google Gemini API key (get free key at https://aistudio.google.com)
GEMINI_API_KEY=

# Database URL.
# - Local dev (default): sqlite:///./fitsense.db
# - Production (per the FitSense stack doc, MySQL is the target):
#     mysql+pymysql://<user>:<password>@<host>:3306/<database>
#   Requires the `pymysql` driver — already listed in requirements.txt.
DATABASE_URL=sqlite:///./fitsense.db


# JWT secret — change this in production
JWT_SECRET=
# OpenWeatherMap API key (free tier: https://openweathermap.org/api)
# Powers live weather in outfit generation, the stylist, and travel packing.
# If left blank, the app falls back to a simulated "Mild & Clear" reading
# so those features keep working without live data.
WEATHER_API_KEY=

# Hugging Face Inference API token (free tier: https://huggingface.co/settings/tokens)
# Powers realistic outfit image generation (FLUX.1-schnell) on the Stylist
# and Outfit Generator. If left blank, recommendations are returned without
# an image rather than failing.
HUGGINGFACE_API_KEY=