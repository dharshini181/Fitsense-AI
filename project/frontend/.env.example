# FitSense AI 2.0 — Frontend Environment Variables
# Copy this file to .env.local and adjust if needed

# Base URL of the backend API (FastAPI). Must include the /api suffix.
# Local dev (default, matches backend running on port 8000):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Production example:
# NEXT_PUBLIC_API_URL=https://api.yourfitsensedomain.com/api
