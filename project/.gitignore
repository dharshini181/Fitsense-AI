# ============================================================
# FitSense AI 2.0 — root .gitignore
# ============================================================

# ── SECRETS — never commit these, under any name/location ───
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*credentials*.json
*secret*

# ── Python / FastAPI backend ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# SQLite dev databases
*.db
*.sqlite
*.sqlite3
backend/fitsense.db

# ── Node / Next.js frontend ──────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel

# ── Logs & OS/editor junk ────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Deployment / internal documentation ──────────────────────
RUN_AND_DEPLOY.md